# ---- Discord ----
# All Discord settings can be configured in the web UI; these env vars only
# SEED them on the first run. Notifications are delivered to a "destination"
# that is either a webhook URL or a bot channel/thread.
#
# Optional: default channel webhook URL (Server Settings -> Integrations ->
# Webhooks). Leave empty to configure in the UI.
DISCORD_WEBHOOK_URL=
#
# Optional: Discord bot token. Required only if you want to post into a
# channel or thread (rather than via a webhook). Create a bot at
# https://discord.com/developers/applications, copy its token, and invite it to
# your server with permission to view + send messages in the target channel.
DISCORD_BOT_TOKEN=

# ---- Playlists ----
# Optional SEED list of public Apple Music playlist links (comma/newline
# separated), used only on first run to populate state. After that, manage
# playlists from the web UI. You can leave this empty and add them in the UI.
# A link looks like: https://music.apple.com/us/playlist/my-mix/pl.u-xxxxxxxxxxxx
PLAYLISTS=

# ---- Watcher behaviour ----
# How often to poll Apple Music, in seconds.
POLL_INTERVAL_SECONDS=300

# ---- Web UI ----
# Port for the management UI (add/remove playlists). Open http://localhost:PORT
WEB_PORT=8080

# ---- Storage ----
# Where to persist the watch list + playlist snapshots between runs.
STATE_FILE=./data/state.json
