# ---- Discord ----
# Channel webhook URL (Server Settings -> Integrations -> Webhooks -> New Webhook).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxx

# ---- Playlists to watch ----
# One or more PUBLIC Apple Music playlist share links, comma- or newline-separated.
# Get a link from the Music app: playlist -> ... -> Share -> Copy Link.
# It looks like: https://music.apple.com/us/playlist/my-mix/pl.u-xxxxxxxxxxxx
PLAYLISTS=https://music.apple.com/us/playlist/my-mix/pl.u-xxxxxxxxxxxx

# ---- Watcher behaviour ----
# How often to poll Apple Music, in seconds.
POLL_INTERVAL_SECONDS=300

# ---- Storage ----
# Where to persist playlist snapshots between runs.
STATE_FILE=./data/state.json
