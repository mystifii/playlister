# ---- Discord ----
# Optional: channel webhook URL (Server Settings -> Integrations -> Webhooks).
# You can leave this empty and set it later in the web UI. It's used only on
# the first run to seed the value; after that the UI is the source of truth.
DISCORD_WEBHOOK_URL=

# ---- Playlists ----
# Optional SEED list of public Apple Music playlist links (comma/newline
# separated), used only on first run to populate state. After that, manage
# playlists from the web UI. You can leave this empty and add them in the UI.
# A link looks like: https://music.apple.com/us/playlist/my-mix/pl.u-xxxxxxxxxxxx
PLAYLISTS=

# ---- Watcher behaviour ----
# How often to poll Apple Music, in seconds.
POLL_INTERVAL_SECONDS=300

# ---- Web UI ----
# Port for the management UI (add/remove playlists). Open http://localhost:PORT
WEB_PORT=8080

# ---- Storage ----
# Where to persist the watch list + playlist snapshots between runs.
STATE_FILE=./data/state.json
